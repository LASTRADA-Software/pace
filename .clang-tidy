# cppcoreguidelines-pro-type-vararg is disabled: POSIX APIs we have to call
# (open(), fcntl(), ioctl(), etc.) are declared variadic and there is no
# non-variadic alternative. Suppressing per-call with NOLINT adds noise.
#
# clang-analyzer-core.uninitialized.Assign is disabled: the static analyzer
# does not model the discriminated-union invariant of std::expected, so its
# monadic operations (transform_error et al.) trip a false "field is
# uninitialized" report when the expected actually holds its value alternative.
# The narrower clang-analyzer-optin.cplusplus.UninitializedObject below is
# disabled for the same family of std::expected/optional false positives.
#
# performance-no-int-to-ptr is disabled: a Win32 SOCKET is an integer and the API
# it must reach (CreateIoCompletionPort, CancelIoEx) takes a HANDLE, so the
# conversion is required by the platform and cannot be written another way. NOLINT
# is banned in this tree, so the choice is this row or a Windows analyser leg that
# can never go green.
#
# Measured before disabling rather than assumed: run alone over all 376 project
# translation units in the Linux compile database the check reports NOTHING, and
# that zero was checked with a positive control -- an int-to-ptr planted in
# Base64.cpp is found, and removing it returns the count to zero. Every occurrence
# in this repository is Win32 handle code no other platform compiles.
#
# The rationale lives HERE and not beside the row, because `Checks:` is a `>-`
# block scalar in which `#` is NOT a comment: a commented row there is silently
# spliced into the check list. That is how the first attempt at this change left
# the exclusion inert while looking applied -- the sweep went on reporting the
# five findings it was meant to retire.
---
Checks: >-
  -*,
  bugprone-*,
  -bugprone-branch-clone,
  -bugprone-crtp-constructor-accessibility,
  -bugprone-exception-escape,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-reserved-identifier,
  -bugprone-suspicious-include,
  -bugprone-chained-comparison,
  -bugprone-std-namespace-modification,
  -bugprone-throwing-static-initialization,
  clang-analyzer-core.*,
  -clang-analyzer-core.uninitialized.Assign,
  clang-analyzer-cplusplus.*,
  clang-analyzer-deadcode.*,
  clang-analyzer-nullability.*,
  clang-analyzer-optin.cplusplus.*,
  -clang-analyzer-optin.cplusplus.UninitializedObject,
  clang-analyzer-optin.performance.*,
  clang-analyzer-optin.portability.*,
  clang-analyzer-security.*,
  clang-analyzer-unix.*,
  clang-diagnostic-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-const-cast,
  -cppcoreguidelines-pro-type-cstyle-cast,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-type-vararg,
  modernize-*,
  -modernize-avoid-bind,
  -modernize-avoid-c-arrays,
  -modernize-avoid-c-style-cast,
  -modernize-use-trailing-return-type,
  performance-*,
  -performance-no-int-to-ptr,
  readability-*,
  -readability-convert-member-functions-to-static,
  -readability-avoid-unconditional-preprocessor-if,
  -readability-braces-around-statements,
  -readability-else-after-return,
  -readability-identifier-length,
  -readability-implicit-bool-conversion,
  -readability-inconsistent-ifelse-braces,
  -readability-magic-numbers,
  -readability-redundant-access-specifiers,
  -readability-redundant-member-init,
  -readability-simplify-boolean-expr,
  -readability-use-concise-preprocessor-directives,
  -readability-redundant-parentheses
WarningsAsErrors: "*"
UseColor: true
# Which headers findings are reported for. Everything else is discarded as
# "non-user code" -- SILENTLY, with only a `Suppressed NNN warnings` line to show
# for it, which is why this pattern being slightly wrong is expensive rather than
# annoying.
#
# It must match a checkout whatever it is CALLED, and it must not depend on where
# DEPENDENCIES are unpacked either. Both halves have now been got wrong:
#
#   `.*/fastcached/src/.*`                        missed `fastcached-wt-139/`
#   `.*/(fastcached[^/]*|worktrees/[^/]+)/src/.*` missed `fastcached-worktrees/<lane>/`
#   `.*/src/.*` + exclude `.*/_deps/.*`           missed CI's `.cache/CPM/`
#
# The second is #1040: `fastcached[^/]*` matches the SEGMENT `fastcached-worktrees`
# and then demands `/src/` immediately, while `worktrees/[^/]+` needs a segment that
# is literally `worktrees`. Every lane worktree analysed ZERO first-party headers and
# reported clean, invisibly, because CI clones to `.../fastcached/src/...` -- the one
# shape that still matched.
#
# The THIRD was the fix for the second, and it is the same mistake wearing the other
# hat. Excluding `_deps` is right on a developer machine, where FetchContent unpacks
# there; `build.yml` sets `CPM_SOURCE_CACHE: ${{ github.workspace }}/.cache/CPM`, so
# CI's catch2 sits at `.cache/CPM/catch2/<hash>/src/catch2/...` -- which contains
# `/src/` and is not under `_deps`. The broad pattern took it, and the sweep failed
# inside catch2. An EXCLUSION bets on where the world puts things; only CI could see
# that bet lose, and it did.
#
# So the pattern now states what is OURS and mentions no dependency location at all.
# The roots under `src/` are this repository's own directories, and a dependency
# unpacked anywhere -- `_deps`, `.cache/CPM`, or a location nobody has invented yet --
# cannot match, because catch2's headers live under `src/catch2/` and `catch2` is not
# one of these names. Measured across both layouts: reported 1 and 0 under the old
# pattern, 0 and 0 under this one, with a first-party control finding still reported
# in every case.
#
# The cost of enumerating roots is that a FIFTH root would go unanalysed in silence,
# and that is exactly what `scripts/local-gate.sh` now refuses: it applies this regex
# to every tracked header and reports `<matched>/<total>`, so a new root shows up as
# `286/287` with the missed file named. The enumeration is safe only because that
# check exists -- do not weaken one without the other.
#
# Every separator is `[/\\]`, because the path the filter is matched against is the
# path a header was OPENED by, and on Windows that is not the POSIX one: the MSVC
# compile database spells its include directories with backslashes, so a header opens
# as `D:\...\src/tests/X.hpp`. Spelled with `/` alone, this pattern matched no header
# on a Windows run -- a naming violation planted in one was reported 0 times, and twice
# once either separator was accepted -- and the run still read clean, since the main
# file's findings came through. local-gate's coverage check could not see it, matching
# POSIX paths only. `ctest -R tidy-header-filter` asks every tracked header in the
# POSIX, all-backslash and MSVC-mixed spellings, and that no spelling of a dependency
# path is taken; and `scripts/tidy-sweep.sh`'s header canary makes the analyser itself
# report a finding planted in two headers before any sweep is believed, on whichever
# host the sweep runs. In a YAML single-quoted scalar a backslash is literal, and inside
# a POSIX bracket expression -- `llvm::Regex` is one -- so is the regex's.
HeaderFilterRegex: '.*[/\\]src[/\\](CowTree|Pace|apps|tests)[/\\].*'
FormatStyle:     none
CheckOptions:
  - key:             readability-function-cognitive-complexity.Threshold
    value:           '60'
  - key:             readability-function-cognitive-complexity.IgnoreMacros
    value:           true
  - key:             bugprone-easily-swappable-parameters.MinimumLength
    value:           '4'
  - key:             bugprone-unused-return-value.AllowCastToVoid
    value:           'true'
  - key:             cert-dcl16-c.NewSuffixes
    value:           'L;LL;LU;LLU'
  - key:             cert-oop54-cpp.WarnOnlyIfThisHasSuspiciousField
    value:           '0'
  - key:             cppcoreguidelines-explicit-virtual-functions.IgnoreDestructors
    value:           '1'
  # The C functions whose result is an OWNER, so `gsl::owner<std::FILE*> x = f(...)` is accepted
  # for them. The check's default list plus `::_wfsopen`: the CRT's wide-path, share-mode `fopen`,
  # which DurableFile.cpp and NodeKey.cpp call on Windows exactly where POSIX calls `std::fopen`.
  # Setting the key REPLACES the default, so the default's seven stay spelled out.
  - key:             cppcoreguidelines-owning-memory.LegacyResourceProducers
    value:           '::malloc;::aligned_alloc;::realloc;::calloc;::fopen;::freopen;::tmpfile;::_wfsopen'
  - key:             cppcoreguidelines-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
    value:           '1'
  - key:             google-readability-braces-around-statements.ShortStatementLines
    value:           '1'
  - key:             google-readability-function-size.StatementThreshold
    value:           '800'
  - key:             google-readability-namespace-comments.ShortNamespaceLines
    value:           '10'
  - key:             google-readability-namespace-comments.SpacesBeforeComments
    value:           '2'
  - key:             modernize-loop-convert.MaxCopySize
    value:           '16'
  - key:             modernize-loop-convert.MinConfidence
    value:           reasonable
  - key:             modernize-loop-convert.NamingStyle
    value:           CamelCase
  - key:             modernize-pass-by-value.IncludeStyle
    value:           llvm
  - key:             modernize-replace-auto-ptr.IncludeStyle
    value:           llvm
  - key:             modernize-use-nullptr.NullMacros
    value:           'NULL'
  - key:             modernize-use-default-member-init.UseAssignment
    value:           '1'
  - key:             readability-identifier-naming.GlobalVariableCase
    value:           camelBack
  - key:             readability-identifier-naming.GlobalConstantCase
    value:           CamelCase
  - key:             readability-identifier-naming.StaticVariableCase
    value:           camelBack
  - key:             readability-identifier-naming.FunctionCase
    value:           CamelCase
  - key:             readability-identifier-naming.FunctionIgnoredRegexp
    value:           '^(main|begin|end|push_back|pop_back|data|str|get|size|length|resize|empty|clear|value|c_str|capacity|to_string|string_view|assign|at|reserve|substr|sv|await_ready|await_suspend|await_resume|initial_suspend|final_suspend|unhandled_exception|return_value|return_void|yield_value|get_return_object|get_return_object_on_allocation_failure|address|operator_new|operator_delete|from_promise|allocate|deallocate)$'
