//
// The one unit that spells the per-commit version strings, so a new commit
// recompiles this file rather than every unit that reports the version. See
// Version.hpp.

#include <Pace/Core/Version.hpp>
#include <Pace/Protocol/CompileCacheWire.hpp>

namespace Pace
{

constinit std::string_view const VersionString = "@PACE_VERSION_STRING@";

constinit std::string_view const ServerVersionBanner = "pace-@PACE_VERSION_STRING@";

// A scheduler records twice the version a node sends (`AdvertisedVersion`), so the
// longest version a build can spell is held against the wire's ceiling here, where
// the string is a literal, rather than in every unit that advertises it.
static_assert(std::string_view { "@PACE_VERSION_STRING@" }.size() * 2 <= CompileCacheWire::MaxNodeVersionBytes,
              "a scheduler must record twice the version this node sends");

} // namespace Pace
