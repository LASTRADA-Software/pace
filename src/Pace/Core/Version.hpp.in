#pragma once

// Generated by CMake from cmake/Version.cmake. Do not edit by hand.
// The git tag is the single source of truth; see cmake/Version.cmake for the
// resolution order and for what each of the values below may contain.
//
// Only the release triple is spelled here. The two strings that carry the
// git-describe distance and commit change on EVERY commit, so they are defined
// once, in the generated Version.cpp, and declared below: spelled in this
// header, every unit including it would compile differently on every commit,
// and none of them could be answered from a compiler cache across commits.

#include <string_view>

namespace Pace
{

/// Numeric version triple, MAJOR.MINOR.PATCH with no suffix (e.g. "1.2.3"),
/// extracted at configure time. This is the value every packaging format sees.
inline constexpr std::string_view Version = "@PACE_VERSION@";

/// Full version string. Equal to Version for a build of a tagged commit;
/// otherwise it carries the git-describe distance and commit, plus a -dirty
/// marker for an unclean tree — e.g. "1.2.3-12-gdeadbee".
///
/// Two provisional forms exist and are the ones a bug report is most likely to
/// quote, so recognise them: "0.0.0-0-g<sha>" is a git work tree in which no
/// release tag is reachable (a fresh fork, or a CI checkout whose tags were not
/// fetched), and "0.0.0-unknown" is a build with neither a tag nor
/// -DPACE_VERSION — an exported source tarball, or the Docker image, whose
/// build context excludes .git/. Neither names a release.
///
/// Defined in the generated Version.cpp (see the note at the top of this file),
/// constant-initialized, so it is safe to read from any other unit's dynamic
/// initializer.
extern std::string_view const VersionString;

/// Full server-version banner emitted by `version` (memcached text) and
/// `INFO` (Redis RESP). Defined beside `VersionString`, for the same reason.
extern std::string_view const ServerVersionBanner;

} // namespace Pace
