#pragma once

// Generated by CMake from src/tests/CheckoutPaths.hpp.in. Do not edit by hand.

#include <string_view>

/// Where this checkout is, for the test cases that read a file out of it.
///
/// A header rather than a `target_compile_definitions` because a definition reaches
/// EVERY translation unit of the target, and the compiler cache keys on the command
/// line as well as on the preprocessed text. An absolute path on the command line
/// gave every unit of `PaceTest` and `fastcache-compile-node-tests` -- 382 of a
/// clang-release build's 1017, most of which never named it -- a key no other checkout
/// computes, so a second folder recompiled all of them. Included only where a path is
/// read, the checkout reaches the keys of the units that actually depend on it.
namespace Pace::Testing
{

/// The repository root: the cases that check a document, a packaging file or a source
/// against the code it describes read it from here.
inline constexpr std::string_view CheckoutSourceDir = "@PROJECT_SOURCE_DIR@";

/// The checked-in test fixtures (e.g. the throwaway TLS certificate and key), so a
/// test can open them regardless of the working directory.
inline constexpr std::string_view CheckoutTestDataDir = "@PROJECT_SOURCE_DIR@/testdata";

} // namespace Pace::Testing
