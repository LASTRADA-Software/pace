#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Debian post-removal: drop the enable-state symlinks and reload systemd.
set -e

SERVICE="@PACE_SERVICE_NAME@"
# The socket is the unit an operator enables, so it is the one carrying
# enable-state symlinks that have to be dropped here.
NODE_SOCKET="pace-node.socket"

case "$1" in
    remove)
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper mask "${SERVICE}" >/dev/null 2>&1 || true
            deb-systemd-helper mask "${NODE_SOCKET}" >/dev/null 2>&1 || true
        fi
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi
        ;;
    purge)
        # purge also forgets the enable/disable state deb-systemd-helper kept.
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper purge "${SERVICE}" >/dev/null 2>&1 || true
            deb-systemd-helper unmask "${SERVICE}" >/dev/null 2>&1 || true
            deb-systemd-helper purge "${NODE_SOCKET}" >/dev/null 2>&1 || true
            deb-systemd-helper unmask "${NODE_SOCKET}" >/dev/null 2>&1 || true
        fi
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi
        # Cached data is expendable and can be large; a purge should not leave
        # it behind. The pace-kv user is intentionally NOT deleted — files
        # elsewhere may still be owned by it.
        #
        # Never recurse into something the package does not own. systemd's
        # StateDirectory= creates this path, and an operator may well have
        # bind-mounted a volume onto it or pointed storage_path at it; an
        # unconditional `rm -rf` would then destroy data on an ordinary purge.
        # Removing only an unmounted, non-symlinked directory keeps the cleanup
        # while making that outcome impossible.
        if [ -d /var/lib/pace-kv ] && [ ! -L /var/lib/pace-kv ] \
           && ! mountpoint -q /var/lib/pace-kv 2>/dev/null; then
            rm -rf /var/lib/pace-kv
        fi
        # The compile node's state directory holds WHO the machine is -- its
        # identity key and its id (#178) -- and a purge is the request to forget
        # everything the package made, so it goes too, under the same guard. An
        # ordinary `remove` keeps it, and so does the RPM's erase, which has no
        # purge to tell the two apart: a reinstall then comes back as the machine
        # the cluster already admitted, rather than as a stranger to re-admit.
        if [ -d /var/lib/pace-node ] && [ ! -L /var/lib/pace-node ] \
           && ! mountpoint -q /var/lib/pace-node 2>/dev/null; then
            rm -rf /var/lib/pace-node
        fi
        ;;
esac

exit 0
