#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Debian post-install: create the service account, its state directory, and
# enable + start the unit.
set -e

SERVICE="@FASTCACHED_SERVICE_NAME@"

case "$1" in
    configure)
        # Create the service accounts from the shipped sysusers.d entries.
        # Two of them, and they are separate on purpose: pace-kv owns the
        # cache storage while the compile worker runs a compiler, and the trust
        # model gives a worker no cache credentials at all.
        # systemd-sysusers is idempotent, so an upgrade over an existing user
        # is a no-op rather than an error.
        if [ -x /usr/bin/systemd-sysusers ] || [ -x /bin/systemd-sysusers ]; then
            systemd-sysusers "@FASTCACHED_SYSUSERS_FILE@" >/dev/null 2>&1 || true
            systemd-sysusers "@FASTCACHED_NODE_SYSUSERS_FILE@" >/dev/null 2>&1 || true
        fi
        if [ -x /usr/bin/systemd-tmpfiles ] || [ -x /bin/systemd-tmpfiles ]; then
            systemd-tmpfiles --create "@FASTCACHED_TMPFILES_FILE@" >/dev/null 2>&1 || true
        fi


        # **Restrict the machine-wide configs to their service accounts.**
        #
        # `install(FILES)` runs at PACKAGE-BUILD time, when neither account exists,
        # so it cannot chown -- which is why the payload ships `0644 root:root` and
        # why this is the only place the mode can be set. It runs AFTER
        # `systemd-sysusers` above for the same reason.
        #
        # These are the files the product's own guidance tells operators to put
        # `requirepass` into, and `Platform/FileTrust` already warns when a secret is
        # read from a broadly-readable file -- so the daemon was built to complain
        # about the file its own package shipped
        # ([#861](https://github.com/LASTRADA-Software/fastcached/issues/861)).
        #
        # DIFFERENT groups, not one: `pace-kv.service` runs as `pace-kv` and
        # `pace-node.service` as `fastcache-node`, and
        # `pace-node.sysusers` states that sharing an account would let a
        # compromised compile rewrite every cached object. A shared group is that hole
        # one notch weaker. `pace-node.yaml` already documents
        # `0640 root:fastcache-node` as the intent; the packaging never did it.
        #
        # Repaired ONLY when the file is CURRENTLY WORLD-readable, so an
        # operator who narrowed it further is left alone -- the same upgrade rule #741
        # applies on Windows.
        #
        # `-perm /0004` is WORLD-readable specifically, not "anyone but the owner".
        # `/0044` would also match the `0640 root:<svc>` this very loop produces, so
        # every later upgrade would re-assert it and would overwrite a GROUP an operator
        # had deliberately chosen. World-readable is the defect; a group arrangement is
        # a decision.
        for _pair in "/@FASTCACHED_SYSCONF_DIR@/fastcached.yaml:pace-kv" \
                     "/@FASTCACHED_SYSCONF_DIR@/pace-node.yaml:fastcache-node"; do
            _conf=${_pair%:*}
            _grp=${_pair##*:}
            [ -f "$_conf" ] || continue
            [ -n "$(find "$_conf" -maxdepth 0 -perm /0004 2>/dev/null)" ] || continue
            chgrp "$_grp" "$_conf" >/dev/null 2>&1 || continue
            chmod 0640 "$_conf" >/dev/null 2>&1 || true
        done

        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi

        # $2 holds the previously-configured version: empty means this is a
        # fresh install, non-empty means an upgrade.
        #
        # On a fresh install the unit is enabled unconditionally. On an upgrade
        # deb-systemd-helper decides, so a unit the operator deliberately
        # disabled stays disabled — `was-enabled` reports the recorded choice
        # rather than the current symlink state.
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper unmask "${SERVICE}" >/dev/null 2>&1 || true
            if [ -z "$2" ] || deb-systemd-helper --quiet was-enabled "${SERVICE}"; then
                deb-systemd-helper enable "${SERVICE}" >/dev/null 2>&1 || true
            else
                deb-systemd-helper update-state "${SERVICE}" >/dev/null 2>&1 || true
            fi
        elif [ -d /run/systemd/system ]; then
            systemctl enable "${SERVICE}" >/dev/null 2>&1 || true
        fi

        if [ -d /run/systemd/system ]; then
            if [ -n "$2" ]; then
                # Upgrade: only bounce an already-running daemon.
                systemctl try-restart "${SERVICE}" >/dev/null 2>&1 || true
            else
                # Fresh install: start it so the cache is up without a second
                # manual step (this is what "auto-start" is expected to mean).
                systemctl start "${SERVICE}" >/dev/null 2>&1 || true
            fi
        fi

        # The `compile-node.env` warning that stood here is gone with #383. It
        # told an operator that a pre-#291 leftover was inert and could be
        # removed; the conffiles `remove-on-upgrade` entry now removes it, at
        # unpack, BEFORE this script runs -- measured, by instrumenting a
        # postinst rather than reading dpkg's phase labels: the file is already
        # gone here whether or not the operator had edited it. An edited copy is
        # saved as `<path>.dpkg-old` and dpkg says so itself, so there is
        # nothing left for this script to report.
        ;;
esac

exit 0
