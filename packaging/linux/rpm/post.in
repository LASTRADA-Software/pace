#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# RPM %post — argument is the number of package versions that will remain
# installed: 1 on a fresh install, 2 or more during an upgrade.
set -e

SERVICE="@PACE_SERVICE_NAME@"

if [ -x /usr/bin/systemd-sysusers ]; then
    systemd-sysusers "@PACE_SYSUSERS_FILE@" >/dev/null 2>&1 || true
    systemd-sysusers "@PACE_NODE_SYSUSERS_FILE@" >/dev/null 2>&1 || true
fi
if [ -x /usr/bin/systemd-tmpfiles ]; then
    systemd-tmpfiles --create "@PACE_TMPFILES_FILE@" >/dev/null 2>&1 || true
fi


# **Restrict the machine-wide configs to their service accounts.**
#
# `install(FILES)` runs at PACKAGE-BUILD time when neither account exists, so it
# cannot chown -- which is why the payload ships `0644 root:root` and why this is
# the only place the mode can be set. Runs AFTER `systemd-sysusers` above for the
# same reason.
#
# These are the files the product's guidance tells operators to put `requirepass`
# into, and `Platform/FileTrust` already warns when a secret is read from a
# broadly-readable file -- the daemon complained about the file its own package
# shipped ([#861](https://github.com/LASTRADA-Software/fastcached/issues/861)).
#
# DIFFERENT groups: the two units run as `pace-kv` and `pace-node`, and
# `pace-node.sysusers` says sharing an account would let a compromised
# compile rewrite every cached object -- a shared group is that hole one notch
# weaker. Repaired only when the file is CURRENTLY WORLD-readable, so a group an
# operator chose is left alone -- and so this loop is idempotent, since the 0640 it
# writes is not world-readable and no later upgrade re-asserts it.
for _pair in "/@PACE_SYSCONF_DIR@/pace-kv.yaml:pace-kv" \
             "/@PACE_SYSCONF_DIR@/pace-node.yaml:pace-node"; do
    _conf=${_pair%:*}
    _grp=${_pair##*:}
    [ -f "$_conf" ] || continue
    [ -n "$(find "$_conf" -maxdepth 0 -perm /0004 2>/dev/null)" ] || continue
    chgrp "$_grp" "$_conf" >/dev/null 2>&1 || continue
    chmod 0640 "$_conf" >/dev/null 2>&1 || true
done

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true

    if [ "$1" -eq 1 ]; then
        # Fresh install: enable for boot and start now.
        systemctl enable "${SERVICE}" >/dev/null 2>&1 || true
        systemctl start "${SERVICE}" >/dev/null 2>&1 || true
    else
        # Upgrade: respect the operator's enable choice, bounce only if running.
        systemctl try-restart "${SERVICE}" >/dev/null 2>&1 || true
    fi
fi

# The `compile-node.env` warning that stood here is gone with #383, and it was
# not merely redundant -- it was WRONG, in the one direction its own comment
# ruled out. It reasoned that the message "is correct either way -- if rpm did
# remove it, the test below simply does not fire". rpm does remove it, and the
# test fired anyway: %post of the new package runs while the retired
# %config(noreplace) file is STILL on disk, and rpm removes it (or saves it as
# `<path>.rpmsave` when the operator had edited it) afterwards, in the same
# transaction. So this printed "The old file is left in place" seconds before
# rpm took it away, and pointed an operator at a path whose contents had moved.
#
# Measured by instrumenting a %post rather than reading interleaved output.
# That ordering is the opposite of dpkg's, which retires the conffile at unpack
# and so reaches its postinst with the file already gone -- which is why one of
# these two messages was false and the other merely dead.

exit 0
