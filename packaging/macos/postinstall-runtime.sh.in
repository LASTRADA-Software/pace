#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# Runtime component postinstall. Runs as root, from the macOS Installer.
#
# Every path out of this script exits 0. A non-zero postinstall aborts the whole
# installation and shows the user a dialog that names nothing actionable, so a
# failure to set up a convenience (a symlink, a default config) must never cost
# them the binaries that did install. Same discipline as Return="ignore" in
# packaging/windows/service-actions.xml.
set -u

PREFIX="/@PACE_MACOS_PREFIX@"
NODE_ACCOUNT="@PACE_MACOS_NODE_ACCOUNT@"
@PACE_MACOS_SEED_CONFIG@

@PACE_MACOS_CREATE_ACCOUNT@

# The compile worker's account, created here in the RUNTIME component rather than
# beside the daemon's in postinstall-launchdaemon.sh.in. Three reasons, and the
# first is the one that matters:
#
#   * pace-node is Runtime payload, and which launchd choice the
#     operator picked for *pace-kv* says nothing about whether they will run a
#     worker. Creating it from the LaunchDaemon component would leave anyone who
#     took the default (the per-user agent) unable to install a system-scope
#     worker at all -- which is the bug this closes, moved rather than fixed.
#   * It mirrors Linux, where pace-node.sysusers is likewise a
#     Runtime asset applied unconditionally by the deb/rpm scriptlets.
#   * The account is inert until something registers a job as it: shell
#     /usr/bin/false, no home, IsHidden.
#
# The installer does NOT register the worker itself: whether this machine serves
# compiles at all is the operator's decision, and a registration is a command line
# replayed at every boot. This makes the operator's own
# `pace-node --install-service --service-scope=system` work; without
# the account that command is refused, and without the refusal it would register a
# launchd job running as ROOT that compiles input from the network (issue #87).
# Guarded on the binary, not on a build flag: PACE_BUILD_NODE is OFF in
# somebody's fork sooner or later, and an account for a worker that was never
# shipped is a system account nobody can explain.
if [ -x "${PREFIX}/bin/pace-node" ]; then
    pace_create_account "$NODE_ACCOUNT" "Pace compile node"
fi

# State directory for the system LaunchDaemon. Created here rather than shipped
# as an empty payload directory so its ownership is set by the component that
# actually knows about the service account.
mkdir -p "${PREFIX}/var" "${PREFIX}/var/log" || true

# /etc/paths.d only takes effect for *login* shells, because path_helper runs
# from /etc/profile — an already-open terminal, a non-login `ssh host cmd`, and
# fish (which does not read /etc/profile) all miss it. /usr/local/bin is in the
# stock /etc/paths, so these symlinks make both tools reachable immediately, in
# every shell, without waiting for a new login.
#
# Only an unused name or one already pointing into our prefix is claimed. `-f`
# on its own unlinks whatever is there first, so a self-built or Homebrew
# pace-cc was destroyed silently -- and the uninstaller, seeing a link that
# now points into ${PREFIX}, would go on to remove the replacement too, leaving
# the user with no pace-cc at all. The uninstaller has the mirror of this
# guard; this is the half that went missing.
mkdir -p /usr/local/bin || true
for tool in @PACE_MACOS_LINKED_TOOLS@; do
    # A tool this build did not produce gets no link. `ln -sfn` is perfectly
    # happy to create a dangling one, and the shell would then find a name on
    # PATH that cannot be executed -- worse than the name simply not being there.
    [ -e "${PREFIX}/bin/${tool}" ] || continue
    link="/usr/local/bin/${tool}"
    if [ -e "$link" ] || [ -L "$link" ]; then
        if [ ! -L "$link" ] || [ "$(readlink "$link")" != "${PREFIX}/bin/${tool}" ]; then
            echo "pace-kv: ${link} exists and is not ours; leaving it alone." \
                "${PREFIX}/bin is still on PATH via /etc/paths.d." >&2
            continue
        fi
    fi
    ln -sfn "${PREFIX}/bin/${tool}" "$link" || true
done

exit 0
