#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# LaunchAgent component postinstall. Runs as root, from the macOS Installer.
#
# Registers a per-user launchd agent for the console user, so pace-kv starts
# at their login and runs as them. Exits 0 on every path (see
# postinstall-runtime.sh.in for why).
set -u

PREFIX="/@PACE_MACOS_PREFIX@"
LABEL="@PACE_MACOS_BUNDLE_ID@"

# The system-wide daemon and a per-user agent would both bind 127.0.0.1:6674,
# and pace-kv has no unix-socket endpoint to fall back on. productbuild
# cannot express a mutually exclusive pair of choices (CPack only generates
# && / || dependency expressions), so the two components arbitrate here instead:
# the system daemon wins, because it serves every user rather than one.
if [ -e "/Library/LaunchDaemons/${LABEL}.plist" ]; then
    echo "pace-kv: system LaunchDaemon present; skipping the per-user agent" >&2
    exit 0
fi

# scutil rather than `stat -f %Su /dev/console`: at the login window scutil
# reports an empty name, whereas stat reports `root`, and during Setup Assistant
# it reports `_mbsetupuser`. Testing one empty value beats testing three
# sentinels, and getting it wrong means installing an agent for root.
CONSOLE_USER=$(/usr/sbin/scutil <<'EOF' | /usr/bin/awk '/Name :/ && ! /loginwindow/ { print $3 }'
show State:/Users/ConsoleUser
EOF
)

case "${CONSOLE_USER:-}" in
    "" | root | loginwindow | _mbsetupuser)
        # No usable GUI session: a headless `installer -pkg`, an ssh install, or
        # the login window. Nothing to register now, and nothing is broken —
        # the user can run `pace-kv --install-service` after logging in.
        echo "pace-kv: no console user; run 'pace-kv --install-service' once logged in" >&2
        exit 0
        ;;
esac

UID_OF_USER=$(/usr/bin/id -u "$CONSOLE_USER" 2>/dev/null) || exit 0

# No --config, deliberately. The packaged ${PREFIX}/etc/pace-kv.yaml
# describes the *system* daemon: its cache lives under the package prefix and is
# owned by the service account, which a per-user agent cannot write. Pointing
# the agent at that file would either break its storage or, with a --storage
# passed to compensate, make every later edit to storage_path a silent no-op,
# because a flag in ProgramArguments outranks the same key in YAML. The agent
# uses per-user defaults instead (a cache under ~/Library/Caches), and needs no
# file to exist -- which also means it does not depend on the Runtime
# component's postinstall having run first. macOS does not run component
# postinstalls in declaration order, and that assumption has already cost one
# release its system daemon.
#
# To give the agent a config, re-register it by hand:
#   pace-kv --install-service --service-scope=user --config=<your file>
#
# `launchctl asuser` adopts the target user's bootstrap namespace and audit
# session but explicitly does NOT change credentials, so `sudo -u` is still
# required for the process to actually run as them.
#
# Output is kept, not discarded. A postinstall must exit 0 whatever happens, so
# `|| true` on its own turns a precise diagnostic into an agent that is simply
# absent -- which is what happened to the daemon component once already.
REGISTER_LOG="/var/log/fastcached-install.log"
{
    echo "--- $(date -u '+%Y-%m-%dT%H:%M:%SZ') registering the ${CONSOLE_USER} agent"
    /bin/launchctl asuser "$UID_OF_USER" /usr/bin/sudo -u "$CONSOLE_USER" \
        "${PREFIX}/bin/pace-kv" --install-service --service-scope=user 2>&1
    echo "--- exit=$?"
} >>"$REGISTER_LOG" 2>&1 || true

exit 0
