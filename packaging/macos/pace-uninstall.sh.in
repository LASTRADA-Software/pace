#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# Remove everything the Pace .pkg installed.
#
# macOS packages have no uninstall mechanism of their own: `pkgutil --forget`
# deletes the receipt and not one file. So this script ships as part of the
# payload and is the documented way back out.
set -u

PREFIX="/@PACE_MACOS_PREFIX@"

# The PACKAGE identifier, which is what receipts are filed under -- not a launchd
# label, though the daemon's happens to be the same string. Kept separate from the
# JOBS table below because the two answer different questions: one is what macOS
# recorded about this install, the other is what is registered with launchd.
LABEL="@PACE_MACOS_BUNDLE_ID@"

# Every launchd job this package can leave behind, one row per line:
#
#   <binary under ${PREFIX}/bin>|<launchd label>
#
# Two rows, and the second is not hypothetical: the installer registers only
# pace-kv, but it now creates the account that lets an operator run
# `pace-node --install-service --service-scope=system` by hand. This
# script removes ${PREFIX}, so a worker job left bootstrapped would point at an
# executable that is gone -- registered, unspawnable, and with nothing left on
# disk that knows how to remove it.
JOBS="pace-kv|@PACE_MACOS_BUNDLE_ID@
pace-node|@PACE_MACOS_NODE_LABEL@"

# Every account the postinstalls create, one per line. A stale account is what
# makes the next install pick a DIFFERENT uid, silently orphaning the state
# directory the old one owned -- so removal is as much a part of this package as
# creation, and `ctest -R service-accounts` fails when one is created and not
# removed.
ACCOUNTS="@PACE_MACOS_SERVICE_ACCOUNT@
@PACE_MACOS_NODE_ACCOUNT@"

if [ "$(id -u)" -ne 0 ]; then
    echo "pace-uninstall: must run as root; try: sudo $0" >&2
    exit 1
fi

echo "Removing Pace..."

# --- launchd jobs --------------------------------------------------------
# `launchctl bootout` returns before the teardown finishes: it signals the job
# and leaves the label registered while the process winds down. Checking (or
# reinstalling) immediately afterwards therefore still finds it -- the same
# asynchrony WaitForJobGone handles in ServiceControl.cpp.
wait_for_job_gone() {
    _attempt=0
    while [ "$_attempt" -lt 100 ] && /bin/launchctl print "$1" >/dev/null 2>&1; do
        /bin/sleep 0.1
        _attempt=$((_attempt + 1))
    done
}

# One pass per row of JOBS, so the worker is torn down on exactly the same terms
# as the daemon rather than by a second copy of this that drifts from it.
#
# IFS is set per-read rather than globally: the '|' split must not apply to the
# `for plist in` glob below, which would otherwise stop matching a path.
echo "$JOBS" | while IFS='|' read -r job_binary job_label; do
    [ -n "$job_label" ] || continue

    # Deregistration goes through the binary's own --uninstall-service when it is
    # still there, so "how this project talks to launchd" keeps one
    # implementation -- the same reason the postinstall drives --install-service.
    # The raw bootout below is the fallback for a broken or already-removed binary.
    if [ -x "${PREFIX}/bin/${job_binary}" ]; then
        "${PREFIX}/bin/${job_binary}" --uninstall-service --service-scope=system >/dev/null 2>&1 || true
    fi

    # The system job first, then any per-user agent. Both are best-effort: a
    # scope that was never installed is not an error.
    /bin/launchctl bootout "system/${job_label}" >/dev/null 2>&1 || true
    wait_for_job_gone "system/${job_label}"
    rm -f "/Library/LaunchDaemons/${job_label}.plist" || true

    # Agents are per-user, and the installing user is not necessarily the one
    # running this. Walk every home directory that has one.
    #
    # Both domains, in the same order ServiceControl's own teardown uses. Which one
    # an agent lives in was decided at install time: `gui/<uid>` needs an Aqua
    # session, so one registered over SSH or on a headless machine landed in
    # `user/<uid>` instead. Booting out only `gui/<uid>` left that job running --
    # and still holding 127.0.0.1:6674 -- while the plist below was deleted and
    # ${PREFIX} removed out from under its binary, with nothing left to reach it.
    for plist in /Users/*/Library/LaunchAgents/"${job_label}".plist; do
        [ -e "$plist" ] || continue
        owner=$(/usr/bin/stat -f %Su "$plist" 2>/dev/null) || continue
        owner_uid=$(/usr/bin/id -u "$owner" 2>/dev/null) || continue
        for domain in "gui/${owner_uid}" "user/${owner_uid}"; do
            /bin/launchctl asuser "$owner_uid" /usr/bin/sudo -u "$owner" \
                /bin/launchctl bootout "${domain}/${job_label}" >/dev/null 2>&1 || true
            wait_for_job_gone "${domain}/${job_label}"
        done
        rm -f "$plist" || true
    done
done

# --- PATH integration ----------------------------------------------------
rm -f /etc/paths.d/fastcached || true
# Only remove the symlinks if they still point into our prefix: someone may have
# replaced them with a Homebrew install, and deleting that would be rude.
for tool in @PACE_MACOS_LINKED_TOOLS@; do
    link="/usr/local/bin/${tool}"
    if [ -L "$link" ] && [ "$(readlink "$link")" = "${PREFIX}/bin/${tool}" ]; then
        rm -f "$link" || true
    fi
done

# --- payload -------------------------------------------------------------
# Explicit paths, never `pkgutil --files <id> | xargs rm`: with the package's
# --install-location of /, that listing includes the bare directory entries
# `etc`, `opt` and `Library`, and one missing --only-files would take the system
# with it.
if [ -d "$PREFIX" ] && [ ! -L "$PREFIX" ]; then
    rm -rf "$PREFIX" || true
fi

# --- service accounts ----------------------------------------------------
echo "$ACCOUNTS" | while read -r account; do
    [ -n "$account" ] || continue
    if /usr/bin/dscl . -read "/Users/${account}" >/dev/null 2>&1; then
        /usr/bin/dscl . -delete "/Users/${account}" >/dev/null 2>&1 || true
        /usr/bin/dscl . -delete "/Groups/${account}" >/dev/null 2>&1 || true
    fi
done

# --- receipts ------------------------------------------------------------
# Last, so a failure above still leaves the receipts to diagnose from.
for receipt in $(/usr/sbin/pkgutil --pkgs | grep "^${LABEL}"); do
    /usr/sbin/pkgutil --forget "$receipt" >/dev/null 2>&1 || true
done

echo "Pace removed."
echo "Note: your own config and cache under \$HOME/Library were left in place."
exit 0
